# Copy to .env for local development. In production these are set in the Render dashboard.

# Required. Any long random string; Render generates one in production.
SECRET_KEY=
# True for local development; leave unset (False) in production.
DEBUG=
# Comma-separated host names, for example walleto.example.com. Render's own host name is added automatically.
ALLOWED_HOSTS=
# Optional locally (SQLite is used when empty). In production: Neon's direct connection string,
# postgresql://<user>:<password>@<endpoint>.ap-southeast-1.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Assistant. Without a key and model the Assistant page says it is not set up.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
